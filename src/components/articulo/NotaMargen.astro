---
interface Props {
  texto?: string;
}
---

<aside class="nota-margen">
  {Astro.props.texto}
  <slot />
</aside>
<style>
  aside {
    font-size: var(--text-kicker);
    line-height: 1.55;
    color: var(--muted);
    align-self: center;
    padding-block: var(--space-3);
  }
  @media (max-width: 767px) {
    aside {
      margin-block: var(--space-3) var(--space-5);
    }
  }
</style>
