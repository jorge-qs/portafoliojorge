{
  "name": "portafoliojorge",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.22.1"
  },
  "scripts": {
    "dev": "ASTRO_TELEMETRY_DISABLED=1 astro dev",
    "build": "ASTRO_TELEMETRY_DISABLED=1 astro build",
    "preview": "ASTRO_TELEMETRY_DISABLED=1 astro preview",
    "check": "ASTRO_TELEMETRY_DISABLED=1 astro check && eslint . --max-warnings 0 && node scripts/verificar-tokens.mjs && prettier --check src scripts tests astro.config.ts eslint.config.js vitest.config.ts playwright.config.ts",
    "test": "vitest run",
    "format": "prettier --write src scripts tests astro.config.ts eslint.config.js vitest.config.ts playwright.config.ts package.json tsconfig.json .github/workflows/ci.yml",
    "contenido:pendientes": "node scripts/contenido-pendientes.mjs",
    "e2e:instalar": "PLAYWRIGHT_BROWSERS_PATH=.cache/ms-playwright playwright install chromium",
    "e2e": "PLAYWRIGHT_BROWSERS_PATH=.cache/ms-playwright playwright test"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "7.3.4",
    "@astrojs/mdx": "8.1.1",
    "astro": "7.4.2",
    "katex": "0.19.1",
    "rehype-katex": "7.0.1",
    "remark-math": "6.0.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@fontsource/geist": "5.3.0",
    "@fontsource/geist-mono": "5.3.0",
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.5",
    "eslint": "10.13.0",
    "eslint-plugin-astro": "3.2.1",
    "eslint-plugin-jsx-a11y-x": "0.2.0",
    "postcss": "8.5.31",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.2",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vitest": "5.0.5",
    "yaml": "2.9.1"
  },
  "allowScripts": {
    "fsevents": false
  },
  "overrides": {
    "katex": "$katex"
  }
}
