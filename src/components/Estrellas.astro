---
interface Props {
  semilla?: number;
  excluirEncuentro?: boolean;
}
const { semilla = 11, excluirEncuentro = true } = Astro.props;
let estado = semilla;
const azar = () => (estado = (estado * 16807) % 2147483647) / 2147483647;
const estrellas = Array.from({ length: 60 }, (_, i) => {
  let x: number, y: number;
  do {
    x = azar() * 1280;
    y = azar() * 800;
  } while (excluirEncuentro && Math.hypot(x - 678.4, y - 344) < 112);
  return {
    x,
    y,
    radio: i % 17 === 0 ? 1.1 : 0.5 + azar() * 0.5,
    tono: i % 17 === 0 ? 'oro' : i % 2 === 0 ? 'marfil' : 'gris',
    opacidad: ['baja', 'media', 'alta'][Math.floor(azar() * 3)],
    i,
  };
});
---

<svg
  class="estrellas"
  viewBox="0 0 1280 800"
  preserveAspectRatio="none"
  aria-hidden="true"
  focusable="false"
>
  {estrellas.map((s) => (
    <circle
      cx={s.x}
      cy={s.y}
      r={s.radio}
      class:list={[
        s.tono,
        s.opacidad,
        { 'solo-escritorio': s.i >= 50, 'no-movil': s.i >= 32 },
      ]}
    />
  ))}
</svg>
<style>
  .estrellas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }
  circle {
    fill: var(--text);
  }
  .gris {
    fill: var(--muted);
  }
  .oro {
    fill: var(--accent);
  }
  .baja {
    opacity: var(--stars-low);
  }
  .media {
    opacity: var(--stars-mid);
  }
  .alta {
    opacity: var(--stars-high);
  }
  @media (max-width: 1199px) {
    .solo-escritorio {
      display: none;
    }
  }
  @media (max-width: 767px) {
    .no-movil {
      display: none;
    }
  }
</style>
