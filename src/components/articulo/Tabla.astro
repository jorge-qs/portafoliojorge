---
import { t } from '../../i18n';
import { siguienteBloque } from '../../lib/bloques-articulo';
import type { Idioma } from '../../i18n/config';
import { idiomaDe } from '../../i18n/actual';
interface Props {
  idioma?: Idioma;
}
const { idioma: idiomaProp } = Astro.props;
const idioma = idiomaProp ?? idiomaDe(Astro);
const numero = siguienteBloque(Astro.locals, 'tabla');
---

{/* eslint-disable astro/jsx-a11y/no-noninteractive-tabindex -- Tabla desplazable accesible con teclado. */}
<div
  class="tabla-mdx"
  role="region"
  tabindex="0"
  aria-label={t(idioma, 'articulo.tablaNumerada', { n: numero })}
>
  <table>
    <slot />
  </table>
</div>
<style>
  .tabla-mdx {
    max-width: 100%;
    overflow: auto;
  }
  table {
    border-collapse: collapse;
    min-width: 100%;
    font-size: var(--text-meta);
  }
  table :global(th),
  table :global(td) {
    padding: var(--space-3);
    text-align: left;
    border-bottom: var(--line-width) solid var(--line);
  }
</style>
