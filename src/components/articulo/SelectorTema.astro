---
import { t } from '../../i18n';
import type { Idioma } from '../../i18n/config';
interface Props {
  idioma: Idioma;
  sistema?: boolean;
}
const { idioma, sistema = false } = Astro.props;
---

<div class="selector-tema" role="group" aria-label={t(idioma, 'articulo.tema')}>
  {(sistema ? ['cosmos', 'dawn', 'sistema'] : ['cosmos', 'dawn']).map(
    (tema) => (
      <button type="button" data-tema={tema} aria-pressed="false">
        {t(idioma, `articulo.${tema}`)}
      </button>
    ),
  )}
</div>
<style>
  .selector-tema {
    display: flex;
    gap: var(--space-1);
    padding: var(--space-1);
    background: var(--surface-2);
    border-radius: var(--radius-lg);
    font-size: var(--text-kicker);
  }
  button {
    flex: 1;
    min-height: var(--touch-min);
    border: 0;
    border-radius: var(--radius-sm);
    padding: 0 var(--space-2);
    color: var(--muted);
    background: none;
    cursor: pointer;
  }
  button[aria-pressed='true'] {
    background: var(--surface);
    color: var(--heading);
    font-weight: 500;
  }
</style>
